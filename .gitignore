# ==========================================
# Winmozhi - Open Source .gitignore
# Optimized for .NET 10 / WinUI 3
# ==========================================

# Visual Studio / IDE temporary files
.vs/
*.user
*.userosscache
*.sln.docstates
*.suo

# Build results and compiled binaries
bin/
obj/
x64/
x86/
ARM/
ARM64/
bld/
TestResults/
*.cache

# App Packages and Publishing
AppPackages/
BundleArtifacts/
_pkginfo.txt
*.appx
*.appxbundle
*.appxupload
*.msix
*.msixbundle
*.msixupload
publish/

# NuGet Packages
*.nupkg
*.snupkg
packages/
!packages/build/

# Crash Logs
*.log
logs/
crash.log

# ==========================================
# EXPLICIT INCLUSIONS
# ==========================================
# Ensure all branding, icons, and logos are ALWAYS tracked by Git
!**/Assets/*
!*.png
!*.ico
!*.csv
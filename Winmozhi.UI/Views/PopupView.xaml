<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Winmozhi.UI.Views.PopupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <!-- Windows 11 right-click dialogs (flyouts) use Desktop Acrylic -->
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="Transparent">
        <!-- Rounded corners set to 8px (standard Win11 flyout) -->
        <Border x:Name="RootBorder"
                Background="Transparent"
                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="4"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">

            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>

            <StackPanel Spacing="4">
                <!-- English Typed Word Display -->
                <TextBlock x:Name="CurrentManglishText"
                           FontSize="13" 
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           Margin="8,4,8,4"
                           Opacity="0.7"/>

                <!-- Suggestion List -->
                <ListView x:Name="SuggestionsListView"
                          SelectionMode="Single"
                          IsItemClickEnabled="False"
                          CornerRadius="4"
                          Margin="0"
                          Padding="0"
                          ContainerContentChanging="SuggestionsListView_ContainerContentChanging">

                    <ListView.ItemContainerStyle>
                        <!-- Rounded inner item selection -->
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="36" />
                            <Setter Property="Margin" Value="4,2" />
                            <Setter Property="CornerRadius" Value="4" />
                            <Setter Property="Padding" Value="8,4" />
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" 
                                       FontWeight="SemiBold" 
                                       VerticalAlignment="Center"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>
    </Grid>
</Window>
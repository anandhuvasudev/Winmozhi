<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Winmozhi.UI.Views.PopupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="Transparent">
        <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">

            <StackPanel Spacing="2">
                <TextBlock Text="{x:Bind ViewModel.CurrentManglish, Mode=OneWay}" 
                           FontSize="12" 
                           Foreground="Gray"
                           Margin="8,0,0,4"/>

                <!-- LISTVIEW automatically highlights the SelectedIndex! -->
                <ListView ItemsSource="{x:Bind ViewModel.Suggestions, Mode=OneWay}"
                          SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=OneWay}"
                          SelectionMode="Single"
                          IsItemClickEnabled="False"
                          Margin="-8,0,-8,-8"
                          Padding="4">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{x:Bind}" FontSize="18" FontWeight="SemiBold" Padding="4,2"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>
    </Grid>
</Window>
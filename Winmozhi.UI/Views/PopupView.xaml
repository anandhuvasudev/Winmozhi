<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Winmozhi.UI.Views.PopupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid Background="Transparent">
        <!-- Removed CornerRadius (Set to 0) -->
        <Border Background="Transparent"
                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                BorderThickness="1"
                CornerRadius="0"
                Padding="8"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">

            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>

            <StackPanel Spacing="6">
                <!-- English Typed Word Display -->
                <TextBlock x:Name="CurrentManglishText"
                           FontSize="13" 
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           Margin="8,4,8,6"
                           Opacity="0.8"/>

                <!-- Suggestion List - Removed CornerRadius -->
                <ListView x:Name="SuggestionsListView"
                          SelectionMode="Single"
                          IsItemClickEnabled="False"
                          CornerRadius="0"
                          Margin="-4,0,-4,-4"
                          Padding="0">

                    <ListView.ItemContainerStyle>
                        <!-- Removed CornerRadius on the selection highlight box -->
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="38" />
                            <Setter Property="Margin" Value="4,2,4,2" />
                            <Setter Property="CornerRadius" Value="0" />
                            <Setter Property="Padding" Value="4,2" />
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" 
                                       FontSize="18" 
                                       FontWeight="SemiBold" 
                                       Padding="6,4"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>
    </Grid>
</Window>
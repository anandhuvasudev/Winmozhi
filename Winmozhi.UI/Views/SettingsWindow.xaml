<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Winmozhi.UI.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon"
    Title="Winmozhi Settings">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid Background="Transparent">
        <tb:TaskbarIcon x:Name="TrayIcon" ToolTipText="Winmozhi Manglish Keyboard" DoubleTapped="TrayIcon_DoubleTapped" Visibility="Visible">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Open Settings" Click="ShowSettings_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE713;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Quit Winmozhi" Command="{x:Bind ViewModel.ExitAppCommand}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE7E8;" Foreground="#E81123"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <ScrollViewer>
            <Grid Padding="28,32,28,40" MinWidth="520" MaxWidth="1200" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="മ" FontSize="54" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,6,0,0"/>
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <TextBlock Text="Winmozhi Settings" Style="{ThemeResource TitleLargeTextBlockStyle}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Personalize your Malayalam transliteration experience" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="1000"/>
                    </StackPanel>
                </StackPanel>

                <!-- Left Column: Application -->
                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="16">
                    <TextBlock Text="Application" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <StackPanel Spacing="0">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8,8,0,0" Padding="20,16">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE765;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock Text="Enable Winmozhi Globally" Style="{ThemeResource BodyTextBlockStyle}" FontWeight="SemiBold"/>
                                    <TextBlock Text="Turns the transliteration engine on or off system-wide." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.IsEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0"/>
                            </Grid>
                        </Border>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,1,1" CornerRadius="0,0,8,8" Padding="20,16">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE7BA;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock Text="Start with Windows" Style="{ThemeResource BodyTextBlockStyle}" FontWeight="SemiBold"/>
                                    <TextBlock Text="Automatically run Winmozhi seamlessly in the background on boot." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.RunAtStartup, Mode=TwoWay}" VerticalAlignment="Center" Margin="0"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Right Column: Engine & Typography -->
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="16">
                    <TextBlock Text="Engine &amp; Output Modes" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <StackPanel Spacing="0">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8,8,0,0" Padding="20,16">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE753;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock Text="Enable Online Engine" Style="{ThemeResource BodyTextBlockStyle}" FontWeight="SemiBold"/>
                                    <TextBlock Text="Use Google Input Tools for highly accurate results. Disable for offline privacy." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.IsOnlineEngineEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0"/>
                            </Grid>
                        </Border>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,1,1" CornerRadius="0" Padding="20,16">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8D3;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock Text="FML Legacy Font Output" Style="{ThemeResource BodyTextBlockStyle}" FontWeight="SemiBold"/>
                                    <TextBlock Text="Outputs text mapped to FML encoding for Photoshop." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.IsFmlFontModeEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0"/>
                            </Grid>
                        </Border>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,1,1" CornerRadius="0,0,8,8" Padding="20,16">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8D3;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock Text="ML Legacy Font Output" Style="{ThemeResource BodyTextBlockStyle}" FontWeight="SemiBold"/>
                                    <TextBlock Text="Outputs text mapped to ML encoding for older software." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="2" IsOn="{x:Bind ViewModel.IsMlFontModeEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Bottom: Data Section spans both columns -->
                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="8" Margin="0,20,0,0">
                    <TextBlock Text="Personal Dictionary" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20,16">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7AC;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock Text="Clear Learned Words" Style="{ThemeResource BodyTextBlockStyle}" FontWeight="SemiBold"/>
                                <TextBlock Text="Winmozhi learns your patterns. Click to reset." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind ViewModel.HistoryStatusMessage, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontWeight="SemiBold" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="Clear database" Command="{x:Bind ViewModel.ClearHistoryCommand}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="v1.0.0 • Crafted for Malayalam" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorDisabledBrush}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Winmozhi.UI.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon"
    Title="Winmozhi Settings">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <!-- SYSTEM TRAY ICON (Runs in the background) -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="Winmozhi Manglish Keyboard"
                        IconSource="/Assets/Square44x44Logo.png"
                        DoubleClickCommand="{x:Bind ShowSettingsCommand}">

            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Settings" Click="ShowSettings_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE713;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutSeparator />

                    <MenuFlyoutItem Text="Quit Winmozhi" Command="{x:Bind ViewModel.ExitAppCommand}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE7E8;" Foreground="Red"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <!-- SETTINGS UI -->
        <StackPanel Padding="32" Spacing="24" MaxWidth="600" HorizontalAlignment="Left">
            <TextBlock Text="Winmozhi Settings" FontSize="28" FontWeight="SemiBold" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" CornerRadius="8" Padding="16">

                <StackPanel Spacing="16">
                    <ToggleSwitch Header="Enable Keyboard Hook" 
                                  IsOn="{x:Bind ViewModel.IsEnabled, Mode=TwoWay}" 
                                  OffContent="Paused" OnContent="Running" />

                    <TextBlock Text="When paused, typing will not show Malayalam suggestions." 
                               Foreground="Gray" FontSize="12" Margin="0,-8,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
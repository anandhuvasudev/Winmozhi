<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Winmozhi.UI.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon"
    Title="Winmozhi Settings">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <!-- SYSTEM TRAY ICON (Runs in the background) -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="Winmozhi Manglish Keyboard"
                        DoubleTapped="TrayIcon_DoubleTapped">

            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Settings" Click="ShowSettings_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE713;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>

                    <MenuFlyoutSeparator />

                    <MenuFlyoutItem Text="Quit Winmozhi" Command="{x:Bind ViewModel.ExitAppCommand}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE7E8;" Foreground="Red"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <!-- SETTINGS UI -->
        <StackPanel Spacing="16">
            <!-- Hook Toggle -->
            <ToggleSwitch Header="Enable Keyboard Hook" 
                                  IsOn="{x:Bind ViewModel.IsEnabled, Mode=TwoWay}" 
                                  OffContent="Paused" OnContent="Running" />

            <MenuFlyoutSeparator Margin="0,8,0,8" />

            <!-- Clear History Button -->
            <StackPanel Spacing="8">
                <TextBlock Text="Data Management" FontWeight="SemiBold" />
                <Button Content="Clear Learning History" 
                                Command="{x:Bind ViewModel.ClearHistoryCommand}" 
                                Style="{ThemeResource AccentButtonStyle}" />
                <TextBlock Text="{x:Bind ViewModel.HistoryStatusMessage, Mode=OneWay}" 
                                   Foreground="Green" FontSize="12" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>